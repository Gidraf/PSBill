# Copy to release.env (chmod 600) and fill in. Never commit release.env or the keystore.

# Dedicated clone used only for building (the script resets it to origin/$BRANCH).
REPO_DIR=/opt/psbill-build/PSBill
BRANCH=main
APPS="ajiriwa psbill"                 # which apps to build and publish

# CVPAP API that stores the builds and serves https://.../dl/<app>.apk
CVPAP_URL=https://api.ajiriwa.gidraf.dev
APP_RELEASE_TOKEN=change-me-long-random   # same value as APP_RELEASE_TOKEN in the CVPAP api env

# Signing key (create once with ./create-keystore.sh and BACK IT UP —
# phones only accept updates signed with the same key).
KEYSTORE_FILE=/opt/psbill-build/keys/release.jks
ANDROID_KEY_ALIAS=ajiriwa
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_PASSWORD=change-me

# versionCode = VERSION_OFFSET + number of commits (always increases); name = VERSION_PREFIX.<code>
VERSION_OFFSET=100
VERSION_PREFIX=1

# Optional: build only some Ajiriwa modules (see modules.properties), e.g.
# AJIRIWA_MODULES=dashboard,orders,sms,customers,catalogue,stock

# Where the "last published commit" marker and logs go
STATE_DIR=/opt/psbill-build/state
